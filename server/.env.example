ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# Optional model overrides
ANTHROPIC_MODEL=claude-sonnet-4-6
DEEPGRAM_VOICE=aura-2-luna-en

# Keep true until we deliberately connect a sandbox backend.
SAFE_TEST_MODE=true

# Admin registry. Railway must use true; false is only for local HTTP development.
ADMIN_COOKIE_SECURE=false
ADMIN_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
ADMIN_SETUP_TOKEN=replace-with-a-long-random-one-time-token
# Local Docker PostgreSQL. Replace this with the managed provider URL in production.
DATABASE_URL=postgresql://bluecollar:bluecollar_dev@127.0.0.1:5437/bluecollaragents

# Set to the public frontend origin in production.
PIPECAT_ALLOWED_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
